# Server environment template. Copy to server/.env and fill in real values.

# Port the Express API listens on
PORT=3001

# MongoDB connection string.
# Local dev default below; swap for your MongoDB Atlas URI when deploying:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manoj_tracking
MONGODB_URI=mongodb://127.0.0.1:27017/manoj_tracking

# Secret used to sign auth tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# development | production
NODE_ENV=development